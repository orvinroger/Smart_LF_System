<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Lost & Found System</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" href="/">Smart Lost & Found</a>
            <div class="navbar-collapse">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Items">Items</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Items/Create">Report Lost/Found Item</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <div class="container">
            <span class="text-muted">© 2026 Smart Lost & Found System</span>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>